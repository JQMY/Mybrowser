<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nexora Settings"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customize your browsing experience"
            android:textSize="14sp"
            android:textColor="#666666"
            android:paddingBottom="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Appearance"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose your Nexora home background"
            android:textSize="14sp"
            android:textColor="#555555"
            android:paddingBottom="10dp" />

        <RadioGroup
            android:id="@+id/backgroundGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/cosmicBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cosmic Blue"
                android:textSize="17sp"
                android:padding="10dp" />

            <RadioButton
                android:id="@+id/midnightBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Midnight"
                android:textSize="17sp"
                android:padding="10dp" />

            <RadioButton
                android:id="@+id/oceanBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deep Ocean"
                android:textSize="17sp"
                android:padding="10dp" />

            <RadioButton
                android:id="@+id/purpleBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Purple Galaxy"
                android:textSize="17sp"
                android:padding="10dp" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customization"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:paddingTop="25dp"
            android:paddingBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Custom wallpapers&#10;&#10;Accent colors&#10;&#10;Custom shortcuts&#10;&#10;Search engine selection&#10;&#10;Home page layout"
            android:textSize="15sp"
            android:textColor="#555555"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Save Settings"
            android:textSize="16sp"
            android:layout_marginTop="30dp" />

    </LinearLayout>

</ScrollView>